# Default: text files normalized to LF in the repo
* text=auto eol=lf

# Java/Kotlin source
*.java     text eol=lf
*.kt       text eol=lf
*.kts      text eol=lf

# Build files
*.gradle   text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.pro      text eol=lf

# Android resources
*.xml      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml      text eol=lf

# Docs and scripts
*.md       text eol=lf
*.sh       text eol=lf
*.bat      text eol=crlf

# Binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.jar      binary
*.aar      binary
*.apk      binary
*.aab      binary
*.keystore binary
*.jks      binary
