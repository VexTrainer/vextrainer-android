# Normalize line endings
*.kt        text eol=lf
*.kts       text eol=lf
*.xml       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.properties text eol=lf
*.pro       text eol=lf

# Binary files - never touch line endings
*.jar       binary
*.webp      binary
*.png       binary
*.apk       binary
*.aar       binary